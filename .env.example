GEMINI_API_KEY=your-gemini-key-here
BACKEND_API_KEY=any-long-random-string-you-invent
TAVILY_API_KEY=your-tavily-key-here
ALLOWED_ORIGINS=http://localhost:5173
# Local default is a SQLite file. Render supplies a Postgres URL automatically.
DATABASE_URL=sqlite+aiosqlite:///./agent.db
# Check https://ai.google.dev/gemini-api/docs/models for current model IDs
MODEL=gemini-3.5-flash-lite
MAX_TOKENS=8192
PORT=8000
